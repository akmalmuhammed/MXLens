{
    "rewrites": [
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "admin.mxlens.com"
                }
            ],
            "destination": "/admin"
        },
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "admin.mxlens.com"
                }
            ],
            "destination": "/admin/:path*"
        }
    ]
}