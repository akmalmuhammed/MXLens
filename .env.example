# MXLens needs no configuration. Every variable below is optional.
# With an empty environment, emails are analyzed in the browser and the server
# makes no outbound requests.

# --- Enrichment (off by default) ---------------------------------------------
# When true, the server looks up indicators extracted from analyzed emails:
# public IPs, domains and attachment hashes (never the email itself) are sent to
# third-party services. Keyless lookups (DNS MX, URLhaus, PhishTank, WHOIS/RDAP,
# IP geolocation) run as soon as this is enabled; the keyed services below only
# run when their key is set.
MXLENS_ENRICHMENT=false

# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# abuse.ch (MalwareBazaar, ThreatFox): https://auth.abuse.ch/
ABUSECH_API_KEY=
# Google Safe Browsing: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=
# ipinfo.io token for IP geolocation (optional; a keyless fallback is used without it)
IPINFO_TOKEN=
